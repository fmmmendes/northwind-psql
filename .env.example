# Copy to .env (next to docker-compose.yml) to override the defaults.
# Settings below mirror the docker-compose.yml defaults.
POSTGRES_PORT=5432
POSTGRES_DB=northwind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# pgAdmin web UI (http://localhost:5050)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@northwind.com
PGADMIN_DEFAULT_PASSWORD=postgres
